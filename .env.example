# Copy to .env for local Expo, and set the same server values in the Vercel project.
# Never commit .env.

# Public app config (safe to ship in the client)
EXPO_PUBLIC_API_URL=https://your-app.vercel.app

# Server only. Set these in Vercel → Settings → Environment Variables.
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# Optional explicit auth origin. Preview deployments can omit this.
# BETTER_AUTH_URL=https://your-app.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional Google social sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional email delivery for password reset / verification (Resend)
# RESEND_API_KEY=re_xxx
# AUTH_EMAIL_FROM=FaceTag <onboarding@resend.dev>

HUGGINGFACE_API_KEY=hf_YOUR_TOKEN
# HUGGINGFACE_FACE_MODEL=openai/clip-vit-base-patch32
# FACE_MATCH_THRESHOLD=0.8
# FACE_ENGINE=local
# FACE_ALLOW_LOCAL_FALLBACK=true

# Optional production matcher. POST { imageBase64 } and return { embedding: number[] }.
# FACE_EMBEDDING_URL=https://your-insightface-endpoint.example/embed
# FACE_EMBEDDING_TOKEN=

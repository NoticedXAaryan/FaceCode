{
  "expo": {
    "name": "FaceTag",
    "slug": "facetag",
    "scheme": "facetag",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FaceTag needs camera access to scan faces and enroll your face."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}

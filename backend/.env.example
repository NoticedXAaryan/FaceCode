PORT=3000
NODE_ENV=development

# Supabase — get from supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Hugging Face — free at huggingface.co → Settings → Access Tokens
# Used for face embedding generation (free inference API)
HUGGINGFACE_API_KEY=hf_your_token_here

# CORS
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081